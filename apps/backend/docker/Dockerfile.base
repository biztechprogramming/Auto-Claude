# Auto Claude Base Container
# ===========================
# Base image for all Auto Claude Docker containers.
# Includes common dependencies and database clients.

FROM python:3.12-slim

LABEL maintainer="Auto Claude Team"
LABEL description="Base image for Auto Claude containers"
LABEL version="1.0.0"

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # PostgreSQL client for database analysis
    postgresql-client \
    # MySQL client for database analysis
    default-mysql-client \
    # Git for version control operations
    git \
    # Node.js for frontend operations (if needed)
    nodejs \
    npm \
    # Build essentials for compiling Python packages
    build-essential \
    # Curl for health checks and API calls
    curl \
    # jq for JSON processing
    jq \
    # Cleanup apt cache
    && rm -rf /var/lib/apt/lists/*

# Install common Python dependencies
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    pydantic \
    python-dotenv \
    httpx \
    aiofiles

# Create workspace directory
RUN mkdir -p /workspace && chmod 755 /workspace

# Set working directory
WORKDIR /workspace

# Default command (overridden by specific containers)
CMD ["bash"]
