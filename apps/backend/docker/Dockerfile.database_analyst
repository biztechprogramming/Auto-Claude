# Database Analyst Container
# ==========================
# Analyzes database schema before coding phase begins.
# Provides read-only access to database for schema inspection.

# Use Python base image with database clients
FROM python:3.12-slim

LABEL maintainer="Auto Claude Team"
LABEL description="Database Analyst container for schema analysis"
LABEL version="1.0.0"

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PORT=8000

# Install system dependencies including database clients
RUN apt-get update && apt-get install -y --no-install-recommends \
    # PostgreSQL client
    postgresql-client \
    # MySQL client
    default-mysql-client \
    # Git for workspace operations
    git \
    # Build essentials for Python packages
    build-essential \
    # Cleanup
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy requirements first for better layer caching
COPY requirements.txt /app/requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    pydantic \
    python-dotenv

# Copy application code
COPY docker/api /app/docker/api
COPY core/isolation /app/core/isolation
COPY prompts/docker/database_analyst.md /app/prompts/docker/database_analyst.md

# Create non-root user for security
RUN useradd -m -u 1000 analyst && \
    chown -R analyst:analyst /app

# Switch to non-root user
USER analyst

# Expose the API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Run the database analyst server
CMD ["python", "-m", "docker.api.database_analyst_server"]
