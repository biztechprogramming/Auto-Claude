# QA container - runs automated tests via FastAPI
# Inherits FastAPI support from base
FROM auto-claude-base:latest

# Switch to root to install packages
USER root

# Install Playwright and testing tools (QA-specific)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libatspi2.0-0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    && rm -rf /var/lib/apt/lists/*

# Install Playwright
RUN npm install -g playwright && \
    npx playwright install chromium firefox

# Install testing frameworks
RUN npm install -g \
    jest \
    vitest \
    cypress

# Copy QA-specific FastAPI server
COPY docker/api/qa_server.py /api/qa_server.py

# Switch back to node user
USER node

# Set working directory
WORKDIR /api

# Expose API port range (actual port determined at runtime via CONTAINER_PORT env var)
# Default range: 8000-8100 for dynamic allocation
EXPOSE 8000-8100

# Run FastAPI server (port configured via CONTAINER_PORT environment variable)
CMD ["python3", "qa_server.py"]

LABEL container.role="qa"
